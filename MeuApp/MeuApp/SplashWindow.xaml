<Window x:Class="MeuApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Border Background="#111111"
            CornerRadius="25">

        <Grid>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- LOGO -->

                <Border Width="110"
                        Height="110"
                        CornerRadius="55"
                        Background="#222222">

                    <Border.RenderTransform>
                        <RotateTransform x:Name="LogoRotation"
                                         CenterX="55"
                                         CenterY="55"/>
                    </Border.RenderTransform>

                    <TextBlock Text="🚗"
                               FontSize="60"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- NOME -->

                <TextBlock Text="VEHICLE SYSTEM"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>

                <!-- CARREGANDO -->

                <TextBlock Text="Carregando..."
                           Foreground="#888888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>