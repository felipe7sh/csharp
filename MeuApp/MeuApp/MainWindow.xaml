<Window x:Class="MeuApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle System"
        Width="900"
        Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#101010">

    <Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- TÍTULO -->

            <TextBlock Text="Bem-vindo!"
                       Foreground="White"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Sistema de gerenciamento de veículos"
                       Foreground="#888888"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- BOTÃO -->

            <Button Content="Cadastrar veículo"
                    Width="230"
                    Height="55"
                    Margin="0,35,0,0"
                    FontSize="17"
                    Background="#2979FF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

        </StackPanel>

    </Grid>

</Window>