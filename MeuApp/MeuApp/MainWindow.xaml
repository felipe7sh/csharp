<Window x:Class="MeuApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle System"
        Width="664"
        Height="242"
        WindowStartupLocation="CenterScreen"
        Background="#101010">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="444*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="315,25,0,0" Height="168" Width="271" Grid.Row="1">

            <!-- TÍTULO -->

            <TextBlock Text="Bem-vindo!"
                       Foreground="White"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Sistema de gerenciamento de veículos"
                       Foreground="#888888"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- BOTÃO -->

            <Button Content="Cadastrar veículo"
                    Width="230"
                    Height="55"
                    Margin="0,35,0,0"
                    FontSize="17"
                    Background="#2979FF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

        </StackPanel>

    </Grid>

</Window>