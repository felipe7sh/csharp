@model ClienteAtividade.Models.Cliente

@{
    ViewData["Title"] = "Cadastrar Cliente";
}

<h1>Cadastrar Cliente</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">
            Nome
        </label>

        <input asp-for="Nome" class="form-control" />

        <span asp-validation-for="Nome"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">
            E-mail
        </label>

        <input asp-for="Email" class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label">
            Telefone
        </label>

        <input asp-for="Telefone" class="form-control" />

        <span asp-validation-for="Telefone"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Cadastrar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
